prefix_rule(
    pattern = ["dotnet", "restore"],
    decision = "allow",
    justification = "Standard project restore command.",
    match = [
        "dotnet restore",
    ],
)

prefix_rule(
    pattern = ["dotnet", "build"],
    decision = "allow",
    justification = "Standard project build command.",
    match = [
        "dotnet build",
    ],
)

prefix_rule(
    pattern = ["dotnet", "test"],
    decision = "allow",
    justification = "Standard project test command.",
    match = [
        "dotnet test",
    ],
)

prefix_rule(
    pattern = ["dotnet", "run", "--project", "tools/LineCounter/LineCounter.csproj"],
    decision = "allow",
    justification = "Run the repository's read-only C# line counter.",
    match = [
        "dotnet run --project tools/LineCounter/LineCounter.csproj",
    ],
)
